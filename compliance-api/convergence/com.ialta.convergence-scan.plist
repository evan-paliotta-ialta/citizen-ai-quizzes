<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ialta.convergence-scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/evanpaliotta/Desktop/iAltA Test/Citizen AI Engineer/compliance-api/convergence/run_daily.sh</string>
  </array>

  <!-- Daily at 06:47 local, before Evan's day starts and clear of other crons
       (Verivend usage-report 08:30, Claude usage-report 08:45 weekdays). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>47</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/evanpaliotta/Desktop/iAltA Test/Citizen AI Engineer/compliance-api/convergence/cron_logs/launchd_stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/evanpaliotta/Desktop/iAltA Test/Citizen AI Engineer/compliance-api/convergence/cron_logs/launchd_stderr.log</string>
</dict>
</plist>
